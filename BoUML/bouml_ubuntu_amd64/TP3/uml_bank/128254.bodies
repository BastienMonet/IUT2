class Client
!!!128254.java!!!	Client(in nom : String)
    this.nom=nom;
    this.listeComptes = new ArrayList<Compte>();
!!!128382.java!!!	setNom(in nom : String) : void
    this.nom = nom;
!!!128510.java!!!	getNom() : String
    return this.nom;
!!!128638.java!!!	addCompte(inout compte : Compte) : void
    this.listeComptes.add(compte);
!!!128766.java!!!	removeCompte(inout compte : Compte) : void
    this.listeComptes.remove(compte);
!!!128894.java!!!	getListeComptes() : Compte
    return this.listeComptes;
!!!129022.java!!!	getCompte(in numero : String) : Compte
    for(Compte compte: this.listeComptes){
      if(numero.equals(compte.getNumero())) return compte;
    }
    return null;
