class Client
!!!134910.java!!!	Client(in nom : String)
    this.nom=nom;
    this.listeComptes = new ArrayList<Compte>();
!!!135038.java!!!	setNom(in nom : String) : void
    this.nom = nom;
!!!135166.java!!!	getNom() : String
    return this.nom;
!!!135294.java!!!	addCompte(inout compte : Compte) : void
    this.listeComptes.add(compte);
!!!135422.java!!!	removeCompte(inout compte : Compte) : void
    this.listeComptes.remove(compte);
!!!135550.java!!!	getListeComptes() : Compte
    return this.listeComptes;
!!!135678.java!!!	getCompte(in numero : String) : Compte
    for(Compte compte: this.listeComptes){
      if(numero.equals(compte.getNumero())) return compte;
    }
    return null;
