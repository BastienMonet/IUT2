class Compte
!!!129150.java!!!	Compte(in numero : String, in solde : float)
      super();
      this.numero=numero;
      this.solde=solde;
      this.historique = new ArrayList<Operation>();
      this.addObservateur(new Terminal("hello compte"));
!!!129278.java!!!	setSolde(in val : float) : void
        this.solde = val;
!!!129406.java!!!	getSolde() : float
        return this.solde;
!!!129534.java!!!	setNumero(in num : String) : void
        this.numero = num;
!!!129662.java!!!	getNumero() : String
        return this.numero;
!!!129918.java!!!	crediter(in montant : float, in info : String) : boolean
        if(montant>0){
            this.solde += montant;
            this.historique.add(0, new Operation(new Date(), montant));
            this.notiferObs(info + " " + montant + "$");
            return true;
        }
        return false;
!!!130046.java!!!	afficherHistorique() : void
      System.out.println("----- Historique -----\n");
      for(Operation op:this.historique) System.out.println(op);
