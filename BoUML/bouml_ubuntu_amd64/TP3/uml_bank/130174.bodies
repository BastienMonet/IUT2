class Compte
!!!135806.java!!!	Compte(in numero : String, in solde : float)
      this.operations = new ArrayList<>();
      this.numero=numero;
      this.solde=solde;
!!!135934.java!!!	setSolde(in val : float) : void
        this.solde = val;
!!!136062.java!!!	getSolde() : float
        return this.solde;
!!!136190.java!!!	setNumero(in num : String) : void
        this.numero = num;
!!!136318.java!!!	getNumero() : String
        return this.numero;
!!!136446.java!!!	setDecouvertAutorise(in val : float) : void
        this.decouvertAutorise = val;
!!!136574.java!!!	getDecouvertAutorise() : float
        return this.decouvertAutorise;
!!!136702.java!!!	debiter(in montant : float, in info : String) : boolean
        if(montant>0){
            float res = this.solde-montant;
            if(res>=this.decouvertAutorise){ // vérification solde après opératioin
                this.solde = res;
                Operation op = new Operation(new Date(), -1 * solde);
                ajouterOperation(op);
                return true;
            }
        }
        return false;
!!!136830.java!!!	crediter(in montant : float, in info : String) : boolean
        if(montant>0){
            this.solde += montant;
            Operation op = new Operation(new Date(), solde);
            ajouterOperation(op);
            return true;
        }
        return false;
!!!136958.java!!!	toString() : String
        return "je suis le compte bancaire numero " + numero + "avec le solde " + solde;
!!!137086.java!!!	getHistorique() : Operation
      return operations;
!!!137214.java!!!	ajouterOperation(inout op : Operation) : void
     operations.add(op);
